{
  "uid": "neuroflow-quality",
  "title": "NeuroFlow - Quality Monitor",
  "tags": [
    "neuroflow",
    "quality"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Rolling 24h average - evaluation metrics per pipeline",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg_over_time(neuroflow_eval_faithfulness[24h])",
          "legendFormat": "faithfulness {{pipeline_id}}",
          "refId": "A",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg_over_time(neuroflow_eval_answer_relevance[24h])",
          "legendFormat": "answer_relevance {{pipeline_id}}",
          "refId": "B",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg_over_time(neuroflow_eval_context_precision[24h])",
          "legendFormat": "context_precision {{pipeline_id}}",
          "refId": "C",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg_over_time(neuroflow_eval_context_recall[24h])",
          "legendFormat": "context_recall {{pipeline_id}}",
          "refId": "D",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg_over_time(neuroflow_eval_overall[24h])",
          "legendFormat": "overall {{pipeline_id}}",
          "refId": "E",
          "editorMode": "code"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Overall score trend (7 days)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg_over_time(neuroflow_eval_overall[1h])",
          "legendFormat": "overall {{pipeline_id}}",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {},
      "timeFrom": "7d"
    },
    {
      "id": 3,
      "title": "Documents ingested per day",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(neuroflow_ingestion_docs_total[1d]))",
          "legendFormat": "documents",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "timeFrom": "7d",
      "interval": "1d"
    },
    {
      "id": 4,
      "title": "Fine-tuning job history",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT id, status, base_model, domain, fine_tuned_model, training_pair_count, created_at AS \"created\" FROM finetune_jobs ORDER BY created_at DESC LIMIT 50"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "red",
        "name": "Quality anomalies",
        "target": {
          "type": "tags",
          "tags": [
            "anomaly"
          ],
          "limit": 100,
          "matchAny": false
        }
      }
    ]
  }
}