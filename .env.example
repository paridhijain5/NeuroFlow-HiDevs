# ===== NeuroFlow environment variables =====
# Copy to .env for local dev. In production, set these in the Railway dashboard (never commit real values).

# --- Database ---
POSTGRES_PASSWORD=          # Required: strong random password (openssl rand -hex 24)
POSTGRES_URL=               # Required: full connection string, e.g. postgresql://user:pass@host:5432/neuroflow

# --- Redis ---
REDIS_PASSWORD=             # Required: strong random password (openssl rand -hex 24)
REDIS_URL=                  # Required: full connection string, e.g. redis://:pass@host:6379/0

# --- LLM Providers ---
OPENAI_API_KEY=             # Required
ANTHROPIC_API_KEY=          # Optional: for Anthropic provider

# --- MLflow ---
MLFLOW_TRACKING_URI=        # Required: PostgreSQL URL for MLflow backend

# --- Security ---
JWT_SECRET_KEY=             # Required: 256-bit random key (openssl rand -hex 32)
PLUGIN_SECRETS_KEY=         # Required: Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")

# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=  # Optional: OTLP collector endpoint
SENTRY_DSN=                   # Optional: Sentry error tracking

# --- App ---
ENVIRONMENT=                # Required: development | staging | production
LOG_LEVEL=                  # Optional: DEBUG | INFO | WARNING (default: INFO)
